  "core_unix"
  "async"
  "async_ssl"
  "cohttp"
  "uri"
  "yojson"
  "ppx_jane"
  "ppx_yojson_conv"
  "venue-net"
  "binance-protocol"
  "exchange-core"
  "mm-core"
  "fixed-decimal"
  "cohttp-async" {with-test}
  "binance-sim" {with-test}
  "exchange-core-engine" {with-test}
